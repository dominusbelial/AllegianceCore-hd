<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native mesh/texture exporter for the HD pipeline. Decodes the game's native models through the MIT
       AllegianceCore code; expects that repo next to this one unless AllegianceCoreRoot is set. -->
  <PropertyGroup>
    <AllegianceCoreRoot Condition="'$(AllegianceCoreRoot)' == ''">$(MSBuildThisFileDirectory)../../AllegianceCore</AllegianceCoreRoot>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AllegianceCoreRoot)/src/Allegiance.ClientCore.Game/Allegiance.ClientCore.Game.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>
</Project>
